# Токен от @BotFather
BOT_TOKEN=1234567890:AAAbbbCCCdddEEEfff
# ID главных админов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789
# Путь к базе SQLite
DB_PATH=data/bot.db
# Часовой пояс для статистики
TIMEZONE=Europe/Moscow
# Домен для встроенного Caddy (docker compose --profile https): gifts.example.com
DOMAIN=
# Мини-апп «Рулетка подарков»: публичный HTTPS-адрес, по которому доступен веб-сервер бота
# (например https://gifts.example.com). Пусто — кнопка мини-аппа не показывается.
WEBAPP_URL=
# Где слушает веб-сервер бота (за reverse-proxy с HTTPS)
WEB_HOST=0.0.0.0
WEB_PORT=8080
