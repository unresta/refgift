# Токен от @BotFather
BOT_TOKEN=1234567890:AAAbbbCCCdddEEEfff
# ID главных админов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789
# Путь к базе SQLite
DB_PATH=data/bot.db
# Часовой пояс для статистики
TIMEZONE=Europe/Moscow
# Токен Cloudflare Tunnel (docker compose --profile tunnel) — секрет, никому не показывайте
TUNNEL_TOKEN=
# Домен для встроенного Caddy (docker compose --profile https): gifts.example.com
DOMAIN=
# Для оранжевого облака Cloudflare: CADDYFILE=./Caddyfile.cloudflare + сертификат в ./certs (см. README)
CADDYFILE=./Caddyfile
# Мини-апп «Рулетка подарков»: публичный HTTPS-адрес, по которому доступен веб-сервер бота
# (например https://gifts.example.com). Пусто — кнопка мини-аппа не показывается.
WEBAPP_URL=
# Где слушает веб-сервер бота (за reverse-proxy с HTTPS)
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Юзербот для НФТ подарков (автоответ покупателям): https://my.telegram.org → API development tools
# Вход в аккаунт: docker compose run --rm bot python -m bot.userbot_login
USERBOT_API_ID=
USERBOT_API_HASH=
